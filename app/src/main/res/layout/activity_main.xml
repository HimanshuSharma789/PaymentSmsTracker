<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mono_bg"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textHomeDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Thursday, 16 October" />

                <ImageButton
                    android:id="@+id/buttonHomeAdd"
                    style="@style/Widget.Mono.IconButton"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/mono_add"
                    android:src="@drawable/ic_mono_plus" />

                <ImageButton
                    android:id="@+id/buttonHomeSettings"
                    style="@style/Widget.Mono.IconButton"
                    android:contentDescription="@string/mono_settings"
                    android:src="@drawable/ic_mono_sliders" />
            </LinearLayout>

            <TextView
                android:id="@+id/textHomeSpentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Spent in October" />

            <TextView
                android:id="@+id/textHomeHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textAppearance="?attr/textAppearanceDisplayLarge"
                tools:text="₹38,420" />

            <TextView
                android:id="@+id/textHomeDelta"
                style="@style/Widget.Mono.Tag.Yellow"
                android:layout_marginTop="10dp"
                android:drawablePadding="4dp"
                tools:text="₹4,100 less than September so far" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mono_last_7_days"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/textHomeWeekTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            tools:text="₹18,320 total" />
                    </LinearLayout>

                    <com.example.paymentsmstracker.ui.WeekBarsView
                        android:id="@+id/weekBars"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mono_review"
                    android:fontFamily="@font/outfit_700" android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/textHomeLeft"
                    style="@style/Widget.Mono.Tag"
                    tools:text="4 left" />
            </LinearLayout>

            <TextView
                android:id="@+id/textHomeReviewHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mono_review_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <LinearLayout
                android:id="@+id/containerHomeReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:animateLayoutChanges="true"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textHomeReviewEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mono_review_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonHomeSeeAll"
                style="@style/Widget.Mono.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                tools:text="See all 9 to review"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeReady"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/mono_yellow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mono_ready_title"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/mono_on_yellow_meta" />

                        <TextView
                            android:id="@+id/textHomeReadyTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?attr/textAppearanceHeadlineMedium"
                            android:textColor="@color/mono_on_yellow"
                            tools:text="₹6,210" />

                        <TextView
                            android:id="@+id/textHomeReadySub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/mono_on_yellow_meta"
                            tools:text="7 reviewed, not sent yet" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonHomeSend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mono_send"
                        app:backgroundTint="@color/mono_on_yellow"
                        android:textColor="@android:color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.08"
                android:text="@string/mono_more_tools"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/mono_meta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHomeSplits"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/mono_yellow"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iconHomeSplits"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_mono_circle_ink"
                            android:backgroundTint="@color/mono_on_yellow"
                            android:importantForAccessibility="no"
                            android:scaleType="center"
                            android:src="@drawable/ic_mono_people"
                            app:tint="@color/mono_yellow" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:importantForAccessibility="no"
                            android:rotation="45"
                            android:src="@drawable/ic_mono_arrow_up"
                            app:tint="@color/mono_on_yellow" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mono_splits_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/mono_on_yellow" />

                            <TextView
                                android:id="@+id/textHomeSplitsSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/mono_on_yellow_meta"
                                tools:text="2 shared bills not on Splitwise yet" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHomeInsights"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/mono_ink"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:gravity="bottom"
                            android:importantForAccessibility="no"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="16dp"
                                android:background="@drawable/bg_mono_bar"
                                android:backgroundTint="@color/mono_on_ink" />

                            <View
                                android:layout_width="8dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/bg_mono_bar"
                                android:backgroundTint="@color/mono_yellow" />

                            <View
                                android:layout_width="8dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/bg_mono_bar"
                                android:backgroundTint="@color/mono_on_ink" />

                            <View
                                android:layout_width="8dp"
                                android:layout_height="38dp"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/bg_mono_bar"
                                android:backgroundTint="@color/mono_on_ink" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:importantForAccessibility="no"
                            android:rotation="45"
                            android:src="@drawable/ic_mono_arrow_up"
                            app:tint="@color/mono_on_ink" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/insights_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/mono_on_ink" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="@string/insights_sub"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/mono_on_ink" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_mono_nav" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- One Money Manager category line in the Send summary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <View
        android:id="@+id/viewListBreakdownDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_mono_circle_ink" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textListBreakdownName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:fontFamily="@font/outfit_500"
            android:textFontWeight="500"
            tools:ignore="UnusedAttribute"
            tools:text="Food" />

        <TextView
            android:id="@+id/textListBreakdownMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="4 entries" />
    </LinearLayout>

    <TextView
        android:id="@+id/textListBreakdownAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.Mono.Amount"
        tools:text="₹2,780" />
</LinearLayout>

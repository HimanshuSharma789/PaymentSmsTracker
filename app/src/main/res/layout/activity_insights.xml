<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mono_bg"
    android:fitsSystemWindows="true"
    tools:context=".InsightsActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonInsightsBack"
                    style="@style/Widget.Mono.IconButton"
                    android:contentDescription="@string/insights_back"
                    android:src="@drawable/outline_arrow_back_24" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/insights_title"
                    android:fontFamily="@font/outfit_700"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <ImageButton
                    android:id="@+id/buttonInsightsPrev"
                    style="@style/Widget.Mono.IconButton"
                    android:contentDescription="@string/insights_prev"
                    android:src="@drawable/outline_arrow_back_24" />

                <ImageButton
                    android:id="@+id/buttonInsightsNext"
                    style="@style/Widget.Mono.IconButton"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/insights_next"
                    android:rotation="180"
                    android:src="@drawable/outline_arrow_back_24" />
            </LinearLayout>

            <TextView
                android:id="@+id/textInsightsMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Spent in October 2026" />

            <TextView
                android:id="@+id/textInsightsHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textAppearance="?attr/textAppearanceDisplayLarge"
                tools:text="₹38,420" />

            <TextView
                android:id="@+id/textInsightsDelta"
                style="@style/Widget.Mono.Tag.Yellow"
                android:layout_marginTop="10dp"
                android:drawablePadding="4dp"
                tools:text="₹4,100 less than September" />

            <TextView
                android:id="@+id/textInsightsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/insights_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/groupInsightsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/insights_by_category"
                            android:fontFamily="@font/outfit_700"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                        <LinearLayout
                            android:id="@+id/containerInsightsCategories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/insights_top_merchants"
                            android:fontFamily="@font/outfit_700"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                        <LinearLayout
                            android:id="@+id/containerInsightsMerchants"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

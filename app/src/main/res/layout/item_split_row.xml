<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/textSplitDate"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        tools:text="26 Jul" />

    <TextView
        android:id="@+id/textSplitMerchant"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Movie tickets" />

    <TextView
        android:id="@+id/textSplitTotal"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="13sp"
        tools:text="100.00" />

    <TextView
        android:id="@+id/textSplitMyShare"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="13sp"
        tools:text="25.00" />

    <TextView
        android:id="@+id/textSplitFriendsOwe"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="75.00" />

    <TextView
        android:id="@+id/textSplitPeople"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:textSize="12sp"
        tools:text="ME, PUNEET, KUSHAGRA" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Mono: black pills, white cards on warm off-white, sunflower for highlights and selection. -->
    <style name="Base.Theme.PaymentSmsTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mono_ink</item>
        <item name="colorOnPrimary">@color/mono_on_ink</item>
        <item name="colorPrimaryContainer">@color/mono_yellow</item>
        <item name="colorOnPrimaryContainer">@color/mono_on_yellow</item>
        <item name="colorSecondary">@color/mono_ink</item>
        <item name="colorOnSecondary">@color/mono_on_ink</item>
        <item name="colorSecondaryContainer">@color/mono_yellow</item>
        <item name="colorOnSecondaryContainer">@color/mono_on_yellow</item>
        <item name="colorTertiary">@color/mono_yellow</item>
        <item name="colorOnTertiary">@color/mono_on_yellow</item>
        <item name="colorError">@color/mono_error</item>
        <item name="android:colorBackground">@color/mono_bg</item>
        <item name="colorOnBackground">@color/mono_ink</item>
        <item name="colorSurface">@color/mono_bg</item>
        <item name="colorOnSurface">@color/mono_ink</item>
        <item name="colorOnSurfaceVariant">@color/mono_meta</item>
        <item name="colorSurfaceContainerLowest">@color/mono_surface</item>
        <item name="colorSurfaceContainerLow">@color/mono_surface</item>
        <item name="colorSurfaceContainer">@color/mono_surface</item>
        <item name="colorSurfaceContainerHigh">@color/mono_surface</item>
        <item name="colorSurfaceContainerHighest">@color/mono_line</item>
        <item name="colorOutline">@color/mono_line</item>
        <item name="colorOutlineVariant">@color/mono_line</item>
        <item name="android:statusBarColor">@color/mono_bg</item>
        <item name="android:navigationBarColor">@color/mono_bg</item>
        <item name="android:windowLightStatusBar">@bool/mono_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/mono_light_bars</item>

        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Mono.Hero</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Mono.H1</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Mono.H1</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Mono.H2</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Mono.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Mono.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Mono.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Mono.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Mono.Meta</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Mono.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Mono.Meta</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Mono.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Mono.Card</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Mono.Card</item>
        <item name="materialButtonStyle">@style/Widget.Mono.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Mono.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Mono.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.Mono.Card</item>
        <item name="chipStyle">@style/Widget.Mono.Chip</item>
        <item name="toolbarStyle">@style/Widget.Mono.Toolbar</item>
    </style>

    <style name="Theme.PaymentSmsTracker" parent="Base.Theme.PaymentSmsTracker" />

    <style name="Theme.PaymentSmsTracker.EdgeToEdge" parent="Theme.PaymentSmsTracker">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="q">shortEdges</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
    </style>

    <!-- Type scale: every step differs in size and weight. -->
    <style name="TextAppearance.Mono.Hero" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:textSize">56sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Mono.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.Mono.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Mono.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
    </style>
    <style name="TextAppearance.Mono.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>
    <style name="TextAppearance.Mono.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.Mono.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Mono.Amount" parent="TextAppearance.Mono.Title">
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="ShapeAppearance.Mono.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Mono.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Mono.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Mono.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Mono.Pill</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Mono.Button</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>
    <style name="Widget.Mono.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Mono.Pill</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">?attr/colorOnSurface</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.Mono.Button</item>
    </style>
    <style name="Widget.Mono.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.Mono.Button</item>
    </style>
    <!-- Yellow pill for the one action on a screen that moves money out of the app. -->
    <style name="Widget.Mono.Button.Yellow" parent="Widget.Mono.Button">
        <item name="backgroundTint">@color/mono_yellow</item>
        <item name="android:textColor">@color/mono_on_yellow</item>
        <item name="iconTint">@color/mono_on_yellow</item>
    </style>
    <style name="Widget.Mono.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/mono_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Mono.Card</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Mono.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.Mono.Pill</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/mono_chip_bg</item>
        <item name="android:textColor">@color/mono_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Mono.Button</item>
        <item name="chipMinHeight">40dp</item>
    </style>
    <style name="Widget.Mono.NavButton" parent="">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">center</item>
    </style>
    <!-- 44dp white circle with an ink icon, for header actions. -->
    <style name="Widget.Mono.IconButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_mono_circle_surface</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/mono_ink</item>
    </style>
    <!-- Small label pill, e.g. "4 left", "↓ ₹4,100 vs September". -->
    <style name="Widget.Mono.Tag" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Mono.Meta</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:background">@drawable/bg_mono_pill_outline</item>
    </style>
    <style name="Widget.Mono.Tag.Yellow">
        <item name="android:background">@drawable/bg_mono_pill_yellow</item>
        <item name="android:textColor">@color/mono_on_yellow</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
    </style>
    <style name="Widget.Mono.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Mono.H2</item>
        <item name="android:background">@color/mono_bg</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mono: Review. Choice chip: white pill, black with a yellow dot when picked. -->
    <style name="Widget.Review.Chip" parent="Widget.Mono.Chip">
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIcon">@drawable/review_chip_dot</item>
        <item name="checkedIconTint">@color/mono_yellow</item>
        <item name="chipMinHeight">42dp</item>
        <item name="android:textSize">14.5sp</item>
    </style>
    <!-- Secondary choice (subcategory, split mode): outlined, black when picked. -->
    <style name="Widget.Review.Chip.Small">
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipBackgroundColor">@color/review_chip_sm_bg</item>
        <item name="chipStrokeColor">@color/review_chip_sm_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="android:textColor">@color/review_chip_sm_text</item>
        <item name="android:textSize">13.5sp</item>
    </style>
</resources>
